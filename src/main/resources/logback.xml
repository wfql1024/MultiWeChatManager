<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志输出目录由 Launcher 通过 System.setProperty("jfmultichat.logdir", ...) 设置
         Logback 自动解析 ${jfmultichat.logdir} 系统属性；
         万一没设（比如 IDE 直接跑 MainApp 绕过了 Launcher），标准输出仍能看，
         文件则落到工作目录下的 logs/ —— 这就是"项目根 logs/ 里冒日志"的来源，
         所以入口处一律要先把属性设上（见 MainApp / Launcher）。 -->

    <!-- 编码统一 UTF-8（用户 2026-10-11）：
         原来没写 charset → logback 用系统默认（中文 Windows = GBK）→ 日志文件在 VSCode 里全是乱码 ✗。
         现在文件与控制台都显式 UTF-8：文件不带 BOM（与 VSCode 默认识别一致），中文正常。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出 — 按天滚动，保留 7 天 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${jfmultichat.logdir:-logs}/jfmultichat.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${jfmultichat.logdir:-logs}/jfmultichat.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- JavaFX / WebView 日志级别 — 降低噪音 -->
    <logger name="javafx" level="WARN"/>
    <logger name="com.sun.webkit" level="WARN"/>
    <logger name="com.sun.javafx" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
